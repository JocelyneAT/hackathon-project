# Local defaults. Copy to .env; never commit API keys.
BACKEND_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./backend/shiftos.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional explanation wording and AI-generated skill quizzes. Curated quizzes work without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional cross-platform job discovery. Public LinkedIn listings work without this key.
SERPAPI_API_KEY=

# PostgreSQL alternative (provide your own database; not part of default Compose):
# DATABASE_URL=postgresql+psycopg://shiftos:password@127.0.0.1:5432/shiftos
